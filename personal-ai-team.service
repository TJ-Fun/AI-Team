[Unit]
Description=Personal AI Team task board and Ollama chat
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/personal-ai-team
EnvironmentFile=-/etc/personal-ai-team.env
Environment=OLLAMA_URL=http://127.0.0.1:11434
Environment=OLLAMA_MODEL=orchestrator
Environment=TEAM_PORT=8765
Environment=TEAM_DATA_DIR=/var/lib/personal-ai-team
Environment=TEAM_SECRET_KEY_FILE=/etc/personal-ai-team/credential.key
ExecStart=/usr/bin/python3 /opt/personal-ai-team/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/personal-ai-team /home/ubuntu/projects
UMask=0027

[Install]
WantedBy=multi-user.target
